[user]
    name = bear-jordan
    email = bearjordan@gmail.com

[core]
    editor = nvim

[init]
    defaultBranch = main

[rerere]
    enabled = true

[pull]
    rebase = true

[push]
    autoSetupRemote = true
    default = current

[fetch]
    prune = true

[merge]
    conflictstyle = zdiff3

[diff]
    algorithm = histogram

[log]
    abbrevCommit = true

[branch]
    sort = -committerdate
    autosetuprebase = always

[include]
    path = ~/.gitconfig.local

[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
