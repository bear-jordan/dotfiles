<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bear.anacron</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>mkdir -p {{ .chezmoi.homeDir }}/.local/state/anacron && /opt/homebrew/bin/anacron -t {{ .chezmoi.homeDir }}/.config/anacron/anacrontab -S {{ .chezmoi.homeDir }}/.local/state/anacron</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/state/anacron/anacron.log</string>
    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/state/anacron/anacron.log</string>
</dict>
</plist>
